# ============================================
# Maps
# ============================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=c041c97b58243474e5cf18cb

# ============================================
# Database
# ============================================
# ローカル例: postgresql://shotty_user:devpassword123@localhost:5432/shotty_dev
# 本番例:     postgresql://shotty_prod_user:【パスワード】@localhost:5432/shotty_prod
DATABASE_URL=

# ============================================
# NextAuth (Auth.js v5)
# ============================================
# openssl rand -base64 32 で生成
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
AUTH_SECRET=
AUTH_TRUST_HOST=true   # ローカル開発時のみ必須

# ============================================
# 認証プロバイダー
# ============================================

# LINE Login — https://developers.line.biz/console/
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=

# Google OAuth — https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend（メールマジックリンク）— https://resend.com/
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev   # ドメイン検証後は noreply@shotty.net

# ============================================
# AI API
# ============================================
# Gemini（クラブ相談・雑談・スイング解析）— https://aistudio.google.com/apikey
GEMINI_API_KEY=
# 旧単体ルート用（廃止済み /api/ai, /api/swing）
GEMINI_MODEL=gemini-2.5-flash-lite

# Claude（コース戦略・スコア分析）— https://console.anthropic.com/
ANTHROPIC_API_KEY=

# ============================================
# Stripe（Phase 3 で使用）
# ============================================
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
